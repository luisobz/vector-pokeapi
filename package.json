{
  "name": "vector-pokeapi",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @vector-pokeapi/database db:generate",
    "db:migrate": "pnpm --filter @vector-pokeapi/database db:migrate",
    "db:migrate:create": "pnpm --filter @vector-pokeapi/database db:migrate:create",
    "db:seed": "pnpm --filter @vector-pokeapi/database db:seed",
    "db:reset": "pnpm --filter @vector-pokeapi/database db:reset",
    "db:reset:seed": "pnpm db:reset && pnpm db:seed",
    "clean": "turbo run clean && rm -rf node_modules && rm -rf .turbo",
    "reinstall": "pnpm clean && pnpm install"
  },
  "devDependencies": {
    "turbo": "^2.9.16",
    "typescript": "^6.0.3",
    "prettier": "^3.5.3"
  }
}