{
  "name": "@vector-pokeapi/database",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "prisma": {
    "seed": "tsx ./src/seeds/seed.ts"
  },
  "scripts": {
    "db:generate": "prisma generate --config ./prisma.config.ts",
    "db:migrate": "prisma migrate dev --config ./prisma.config.ts",
    "db:migrate:create": "prisma migrate dev --create-only --config ./prisma.config.ts",
    "db:studio": "prisma studio --config ./prisma.config.ts",
    "db:seed": "prisma db seed --config ./prisma.config.ts",
    "db:reset": "prisma migrate reset --config ./prisma.config.ts",
    "postinstall": "pnpm db:generate",
    "clean": "rm -rf node_modules dist"
  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "@prisma/adapter-pg": "7.8.0",
    "dotenv": "17.4.2",
    "@vector-pokeapi/config": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^7.8.0",
    "tsx": "^4.22.4",
    "@types/node": "^24.6.1"
  }
}