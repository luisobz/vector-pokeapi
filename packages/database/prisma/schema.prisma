generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "typedSql"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector(map: "vector"), unaccent]
}

// Pokémon principal
model Pokemon {
  id           Int      @id
  name         String
  nameEs       String?
  description  String?
  types        String[]
  generation   Int
  stats        Json
  sprite       String?
  height       Int?
  order        Int?
  weight       Int?
  embedding    Unsupported("vector(1536)")?

  evolvesFrom  EvolutionEdge[] @relation("EvolvesTo")
  evolvesTo    EvolutionEdge[] @relation("EvolvesFrom")

  @@map("pokemons")
}

// Grafo de evoluciones
model EvolutionEdge {
  id            Int     @id @default(autoincrement())
  fromPokemonId Int
  toPokemonId   Int
  trigger       String  // "level-up" | "use-item" | "trade" | "other"
  minLevel      Int?
  itemName      String?

  from Pokemon @relation("EvolvesFrom", fields: [fromPokemonId], references: [id])
  to   Pokemon @relation("EvolvesTo",   fields: [toPokemonId],   references: [id])

  @@map("evolution_edges")
}

// Templates semánticos pre-vectorizados (UX showcase)
model SearchTemplate {
  id          Int     @id @default(autoincrement())
  queryText   String  @unique @map("query_text")
  category    String?
  embedding   Unsupported("vector(1536)")?
  words       TemplateWord[]

  @@map("search_templates")
}

model TemplateWord {
  id          Int    @id @default(autoincrement())
  templateId  Int
  word        String
  embedding   Unsupported("vector(1536)")

  template    SearchTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, word])
  @@map("template_words")
}